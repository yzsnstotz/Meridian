# Runtime mode: development | test | production
NODE_ENV=development

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# Telegram Bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=123456789:replace_with_real_token

# Optional extra Telegram bot tokens, comma-separated.
# Example: TELEGRAM_BOT_TOKENS=111111111:token_a,222222222:token_b
TELEGRAM_BOT_TOKENS=

# Allowed operator user IDs (required), comma-separated numbers
ALLOWED_USER_IDS=123456789

# Meridian resolves private config, data, state, runtime, log, and socket paths
# from platform defaults. Set only absolute overrides that you actually need.
# MERIDIAN_CONFIG_DIR=/absolute/path/to/config
# MERIDIAN_DATA_DIR=/absolute/path/to/data
# MERIDIAN_STATE_DIR=/absolute/path/to/state
# MERIDIAN_RUNTIME_DIR=/absolute/path/to/runtime
# MERIDIAN_LOG_DIR=/absolute/path/to/logs
# MERIDIAN_SOCKET_DIR=/absolute/path/to/sockets
# MERIDIAN_WORK_ROOT=/absolute/path/to/workspaces

# Optional individual Hub path overrides. The defaults live inside the resolved
# state/socket directories and remain portable across machines.
# MERIDIAN_HUB_SOCKET_PATH=/absolute/path/to/sockets/hub-core.sock
# MERIDIAN_STATE_PATH=/absolute/path/to/state/hub-state.json

# Optional credential store override. Defaults to <state directory>/credentials.
# MERIDIAN_CREDENTIALS_ROOT=/absolute/path/to/state/credentials

# Monitor heartbeat interval in milliseconds
HEARTBEAT_INTERVAL_MS=10000

# Monitor service sync interval for instance registration (spawn/kill) in milliseconds
MONITOR_SYNC_INTERVAL_MS=1000

# Hub monitor update dispatch tick in milliseconds
MONITOR_PROGRESS_TICK_MS=1000

# Default per-chat monitor update interval for /update on (seconds)
MONITOR_UPDATE_DEFAULT_INTERVAL_SEC=30

# Allowed /update interval range in seconds
MONITOR_UPDATE_MIN_INTERVAL_SEC=5
MONITOR_UPDATE_MAX_INTERVAL_SEC=600

# Monitor alert threshold: consecutive heartbeat misses before reporting agent_error
HEARTBEAT_MISSED_THRESHOLD=3

# Optional default working directory used by spawned agents. When unset, the
# portable work root resolves to the current user's home directory.
# AGENT_WORKDIR=/absolute/path/to/projects

# Optional static external service registration.
# When both values are set, the hub routes the listed intents to this socket.
COORDINATOR_SOCKET_PATH=
COORDINATOR_INTENTS=

# Optional Telegram webhook mode. Leave WEBHOOK_URL empty to keep long polling.
# Example: WEBHOOK_URL=https://bot.example.com/webhook
WEBHOOK_URL=
WEBHOOK_PORT=443
WEBHOOK_SECRET_TOKEN=
TELEGRAM_SUMMARY_ONLY=true
TELEGRAM_PUSH_WHITELIST_ONLY=true

# Optional Web GUI server. Set WEB_GUI_ENABLED=true to start it.
WEB_GUI_ENABLED=false
WEB_GUI_PORT=3000

# Orchestrator GUI/API port used by the native supervisor.
GUI_PORT=7701

# Required when WEB_GUI_ENABLED=true. Used for deep links such as
# https://{WEB_GUI_HOST}:{WEB_GUI_PORT}/?thread_id={thread_id}&token={WEB_GUI_TOKEN}
WEB_GUI_HOST=
WEB_GUI_TOKEN=

# Enable HTTPS for the Web GUI. When true, both TLS paths must be set.
WEB_GUI_HTTPS=false
TLS_CERT_PATH=
TLS_KEY_PATH=

# Optional agent auth keys used in later tasks
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
CURSOR_API_KEY=
