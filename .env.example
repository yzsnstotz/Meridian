# meridian-roles environment configuration
# Copy this file to .env.local and fill in values as needed.
# All values have sensible defaults — override only when necessary.

# Meridian hub Unix socket path
HUB_SOCKET_PATH=/tmp/hub-socks/hub-core.sock

# This service's reply socket path (Meridian writes results here)
ROLES_SOCKET_PATH=/tmp/meridian-roles.sock

# HTTP GUI port
GUI_PORT=7701

# Optional HTTP bind host, for example 127.0.0.1 or 0.0.0.0
GUI_LISTEN_HOST=127.0.0.1

# Persistent state file path (atomic JSON read/write)
STATE_FILE_PATH=/var/lib/meridian-roles/state.json
