{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@meridian/contracts": ["packages/contracts/dist/index.d.ts"],
      "@meridian/contracts/*": ["packages/contracts/dist/*"],
      "@meridian/runtime": ["packages/runtime/dist/index.d.ts"],
      "@meridian/runtime/*": ["packages/runtime/dist/*"],
      "@meridian/supervisor": ["packages/supervisor/dist/index.d.ts"],
      "@meridian/supervisor/*": ["packages/supervisor/dist/*"]
    }
  }
}
